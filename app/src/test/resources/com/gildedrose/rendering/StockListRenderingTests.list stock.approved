<html lang="en">
  <head>
    <title>Gilded Rose</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://unpkg.com/htmx.org@2.0.6" integrity="sha384-Akqfrbj/HpNVo8k11SXBb6TlBWmXXlYQrCSqEWmyKJe+hDm3Z/B2WVG4smwBkRVm" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="container my-4">
      <h1 class="h3 mb-3">29 October 2021</h1>
      <form method="post" action="/add-item" hx-post="/add-item" hx-target="table" hx-swap="outerHTML" id="new-item-form"></form>
      <form class="mb-3 text-end"><button class="btn btn-danger" type="submit" hx-post="/delete-items" hx-target="table" hx-swap="outerHTML" hx-confirm="Are you sure you want to delete the items?" hx-include="table input[type='checkbox']:checked" aria-label="Delete selected items">Delete</button></form>
      <table class="table table-striped table-hover table-bordered table-sm align-middle">
        <tr>
          <th></th>
          <th>ID</th>
          <th>Name</th>
          <th>Sell By Date</th>
          <th>Sell By Days</th>
          <th>Quality</th>
          <th>Price</th>
          <th>Edit</th>
        </tr>
        <tr>
          <td></td>
          <td><input form="new-item-form" type="text" name="new-itemId" required="required" size="5" class="form-control form-control-sm" aria-label="New item id"></td>
          <td><input form="new-item-form" type="text" name="new-itemName" required="required" size="20" class="form-control form-control-sm" aria-label="New item name"></td>
          <td><input form="new-item-form" type="date" name="new-itemSellBy" class="form-control form-control-sm" aria-label="New item sell by date"></td>
          <td></td>
          <td class="text-end"><input form="new-item-form" type="number" name="new-itemQuality" required="required" min="0" size="3" class="form-control form-control-sm" aria-label="New item quality"></td>
          <td><input type="submit" form="new-item-form" value="Add" class="btn btn-primary w-100 btn-sm" aria-label="Add new item"></td>
          <td></td>
        </tr>
        <tr>
          <td><input type="checkbox" name="B1" class="form-check-input" aria-label="Select item"></td>
          <td>B1</td>
          <td>banana</td>
          <td>28 October 2021</td>
          <td class="text-end">-1</td>
          <td class="text-end">42</td>
          <td class="text-end">£1.00</td>
          <td><button type="button" class="btn btn-secondary btn-sm w-100" hx-get="/edit/B1" hx-target="table" hx-swap="outerHTML">Edit</button></td>
        </tr>
        <tr>
          <td><input type="checkbox" name="K1" class="form-check-input" aria-label="Select item"></td>
          <td>K1</td>
          <td>kumquat</td>
          <td>30 October 2021</td>
          <td class="text-end">1</td>
          <td class="text-end">101</td>
          <td class="text-end">error</td>
          <td><button type="button" class="btn btn-secondary btn-sm w-100" hx-get="/edit/K1" hx-target="table" hx-swap="outerHTML">Edit</button></td>
        </tr>
        <tr>
          <td><input type="checkbox" name="U1" class="form-check-input" aria-label="Select item"></td>
          <td>U1</td>
          <td>undated</td>
          <td></td>
          <td class="text-end">0</td>
          <td class="text-end">50</td>
          <td class="text-end"></td>
          <td><button type="button" class="btn btn-secondary btn-sm w-100" hx-get="/edit/U1" hx-target="table" hx-swap="outerHTML">Edit</button></td>
        </tr>
      </table>
    </div>
  </body>
</html>
